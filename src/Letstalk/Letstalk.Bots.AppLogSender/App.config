<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!--second-->
    <add key="interval" value="60" />
    <add key="isProduction" value="false" />
    <add key="letstalk:Service" value="http://10.40.40.140/NotificationService/" />
    <add key="letstalk:AuthKey" value="d7la9omvq6hte3oqtq7e" />
    <add key="bot:CategoryGroupMapperPath" value="Configurations\\CategoryGroupMapper.json" />
    <add key="bot:SkipTheseMessagesPath" value="Configurations\\SkipTheseMessages.txt" />
    <add key="fanex:dbsettingpath" value="~/App_Data" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <connectionStrings>
    <add name="LogApi" connectionString="packet size=4096;Data Source=10.18.200.215;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=bodb_CustomerLog;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.18.200.104:808/msmq/private$/entlib" defaultCategory="Letstalk-Bot-Sender" />
  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000" UMPageUrl="~/UserLogin/Common/Offline">
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" />
