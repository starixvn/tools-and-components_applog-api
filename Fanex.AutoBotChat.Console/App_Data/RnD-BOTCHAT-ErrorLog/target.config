<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="Mail.Enabled" value="no" />
		<add key="Mail.From" value="notification@onelab.tw" />
		<add key="Mail.FromName" value="Notification" />
		<add key="Mail.To" value="" />
		<add key="Mail.Cc" value="" />
		<add key="Mail.Bcc" value="" />
		<add key="Mail.Subject" value="Sample - {{Error}} ({{DateTime}}))" />
		<add key="Mail.Template" value="template-mail.html" />
		<add key="Mail.InlineImages" value="exclamation.png" />

		<add key="Push.Enabled" value="yes" />
		<add key="Push.To" value="9317069" />
		<add key="Push.Subject" value="AUTOBOT-{{category}} Error Log" />
		<add key="Push.Template" value="template-push.txt" />
		<add key="Push.Notify" value="yes" />

		<add key="Mail.To.tag" value="abc@onelab.tw" />
		<add key="Push.To.tag" value="abc" />
	</appSettings>
</configuration>
